# Loaded automatically by `npm run dev`, and only by it.
#
# Development is a demo: there is no database to talk to, so the app is told
# that explicitly rather than inferring it from a missing variable. A
# production build gets no such default — whoever deploys it has to say which
# of the two it is, which is the whole point of the flag.
VITE_DEMO_MODE=true

# Nhận diện Trường THPT Phúc Thịnh, để bản chạy thử trông đúng như bản giao.
# Bản dựng production đọc từ .env của máy triển khai, không đọc tệp này.
VITE_SCHOOL_NAME=Trường THPT Phúc Thịnh
VITE_SCHOOL_SHORT_NAME=THPT Phúc Thịnh
VITE_SCHOOL_CITY=HÀ NỘI
VITE_SCHOOL_DOMAIN=c3phucthinh.edu.vn
VITE_SCHOOL_WEBSITE=https://c3phucthinh.edu.vn
VITE_SCHOOL_LOGO=/logo-mark.png
