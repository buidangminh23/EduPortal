# One of the two blocks below must apply, or the app refuses to start.
# That refusal is deliberate: a build that cannot tell whether it is real or a
# demo used to default to being a demo, silently, with fixed passwords.

# ── Real deployment ────────────────────────────────────────────────────────
# Both required. Authentication then goes through Supabase and nothing else.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Demo ───────────────────────────────────────────────────────────────────
# Leave the two above empty and set this to true. No accounts, no passwords:
# visitors pick a role to look through. Everything they enter stays in their
# own browser. Do not set this for a school that is using the product for real.
VITE_DEMO_MODE=false
