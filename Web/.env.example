# One of the two blocks below must apply, or the app refuses to start.
# That refusal is deliberate: a build that cannot tell whether it is real or a
# demo used to default to being a demo, silently, with fixed passwords.

# ── Real deployment ────────────────────────────────────────────────────────
# Both required. Authentication then goes through Supabase and nothing else.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Demo ───────────────────────────────────────────────────────────────────
# Leave the two above empty and set this to true. No accounts, no passwords:
# visitors pick a role to look through. Everything they enter stays in their
# own browser. Do not set this for a school that is using the product for real.
VITE_DEMO_MODE=false

# ── Which school this is ───────────────────────────────────────────────────
# Set these and the whole app says so — header, landing page, browser tab.
# Left empty, everything reads "THPT Nguyễn Du", which is the demo school the
# seeded data describes. Worth setting even for a demo you are showing to a
# particular school: a demo with their own name on it is a different pitch.
VITE_SCHOOL_NAME=
VITE_SCHOOL_SHORT_NAME=
VITE_SCHOOL_CITY=
# The school's own domain, e.g. c3phucthinh.edu.vn. Used to make addresses
# look like the school's. It decides nothing about access.
VITE_SCHOOL_DOMAIN=
# The school's existing public website, if it has one. Shown as a link.
VITE_SCHOOL_WEBSITE=
# Published in the public footer. Each line is hidden when left empty, rather
# than showing a placeholder — the demo footer carried a Ho Chi Minh City
# address and phone number, which would send a Hanoi school's parents to the
# wrong institution.
VITE_SCHOOL_ADDRESS=
VITE_SCHOOL_PHONE=
VITE_SCHOOL_EMAIL=
VITE_SCHOOL_TAGLINE=

# Huy hiệu của trường, đặt trong Web/public/ rồi trỏ vào đây (ví dụ /logo.svg).
# Để trống thì dùng biểu tượng chung của phần mềm — cố ý, vì huy hiệu là dấu
# hiệu chính thức của một trường, không đem làm mặc định cho trường khác được.
# Ưu tiên .svg: hiện sắc nét ở mọi cỡ và nhẹ hơn ảnh.
VITE_SCHOOL_LOGO=

# ── Google sign-in (optional) ──────────────────────────────────────────────
# The school's own OAuth client, from Google Cloud Console. Leave empty and
# the Google button is simply not offered — better than a button that errors.
# Authorised JavaScript origins must include the exact origin this is served
# from, e.g. https://hocsinh.c3phucthinh.edu.vn. The login screen prints the
# current origin so nobody has to guess it.
VITE_GOOGLE_CLIENT_ID=

# ── Tuition transfers (optional) ───────────────────────────────────────────
# The account VietQR codes pay into. Until all three are set the app labels
# the QR as a demo, because a structurally valid QR pointing at a placeholder
# account is worse than no QR.
VITE_SCHOOL_BANK_BIN=
VITE_SCHOOL_BANK_ACCOUNT=
VITE_SCHOOL_BANK_ACCOUNT_NAME=

# ── EduMeet backend (optional) ─────────────────────────────────────────────
# Origin of the Express server that does AI meeting summaries and WebRTC
# signalling. Unset, EduMeet talks to this page's own origin, so a deployment
# without that server fails against itself instead of pointing every visitor
# at their own laptop. Must be https when the app is served over https.
VITE_SERVER_URL=
