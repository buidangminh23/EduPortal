# Cổng máy chủ
PORT=8080
# Giao diện mạng máy chủ nghe. Mặc định 127.0.0.1 — chỉ nginx trên cùng máy gọi
# được. Đặt 0.0.0.0 là nghe MỌI giao diện, kể cả wifi trong trường; chỉ làm khi
# biết rõ vì sao cần, và khi đó tường lửa là thứ duy nhất còn che.
HOST=127.0.0.1
# ── Phiên âm & tóm tắt: ai được dùng model của trường ──
# Máy chủ hỏi Supabase xem người gọi là ai (giống camera), nên cần SUPABASE_URL
# + SUPABASE_ANON_KEY ở cuối tệp. Thiếu -> /api/transcribe và /api/summarize trả
# 503 chứ không mở cho người lạ.
AI_ALLOWED_ROLES=teacher,admin

# ── Proxy đứng trước máy chủ (Cloudflare Tunnel, nginx…) — xem SELF-HOST.md ──
# Số proxy giữa người dùng và tiến trình này, để lấy đúng địa chỉ người gọi.
# Bỏ trống (mặc định): dùng địa chỉ kết nối trực tiếp. Sau tunnel mà bỏ trống thì
# MỌI request trông như đến từ một địa chỉ: giới hạn số lần thử /api/sso/school
# biến thành một rổ chung cho cả trường (một kẻ tấn công khoá cửa của mọi giáo
# viên), và nhật ký ghi tên proxy thay vì người gọi.
# Đặt 1 khi có đúng một proxy; hoặc liệt kê địa chỉ proxy: "loopback, 10.0.0.0/8".
# KHÔNG có giá trị nào nghĩa là "tin mọi header" — TRUST_PROXY=true bị từ chối
# ngay lúc khởi động, vì khi đó người gọi tự khai địa chỉ và cả hai thứ trên
# đều vô hiệu.
TRUST_PROXY=

# ── Whisper (phiên âm giọng nói → văn bản) ──
# Dựng faster-whisper-server hoặc whisper.cpp server nội bộ rồi đặt URL vào đây.
# Bỏ trống -> endpoint vẫn chạy nhưng trả bản mô phỏng.
WHISPER_URL=

# ── LLM tóm tắt (Qwen2.5 chạy nội bộ qua Ollama/vLLM) ──
# Ví dụ Ollama: http://localhost:11434/api/chat
# Bỏ trống -> trả bản mô phỏng.
LLM_URL=
LLM_MODEL=qwen2.5:14b

# ── Fallback API (tuỳ chọn, chỉ khi không có model nội bộ) ──
GEMINI_API_KEY=

# ── STUN/TURN cho WebRTC (client dùng khi thiết lập RTCPeerConnection) ──
# STUN miễn phí của Google đủ cho mạng thường; TURN cần khi vượt NAT/tường lửa.
# Xem README mục "STUN/TURN".
# TURN_URL=turn:your-turn-server:3478
# TURN_USER=
# TURN_PASS=

# ── Camera giám sát (chỉ Ban Giám Hiệu) — xem CAMERA.md ──
# Danh sách camera; tệp này chứa mật khẩu camera nên KHÔNG commit.
CAMERA_CONFIG_FILE=./data/cameras.json
# Địa chỉ MediaMTX (WebRTC) trên máy đặt tại trường.
CAMERA_RELAY_URL=
# openssl rand -hex 32 — ký vé xem, thiếu cái này thì API từ chối mọi yêu cầu.
CAMERA_TICKET_SECRET=
CAMERA_TICKET_TTL_SECONDS=120
# openssl rand -hex 24 — khoá để lớp AI gửi ghi nhận về.
CAMERA_EVENT_KEY=
CAMERA_ACCESS_LOG=./data/camera-access.log
CAMERA_ALLOWED_ROLES=admin

# Server tự hỏi Supabase xem người gọi là ai; không dùng service key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Đăng nhập một lần từ website trường (SSO) — xem docs/sso-school-integration.md ──
# openssl rand -hex 32 — CHUỖI NÀY PHẢI GIỐNG HỆT bên website trường.
# Ai có nó thì tự tạo được phiếu đăng nhập cho bất kỳ ai, kể cả quyền admin:
# trao tay hoặc đọc qua điện thoại, không gửi qua email/chat, không commit.
# Bỏ trống -> /api/sso/school trả 503, phần còn lại của server vẫn chạy.
SCHOOL_SSO_SECRET=
# Phải khớp đúng trường "iss" mà website trường ký vào phiếu.
# BẮT BUỘC: bỏ trống -> 503. Trước đây bỏ trống là lặng lẽ bỏ luôn bước kiểm tra
# này, cửa vẫn mở nhưng thiếu một lớp — nay thiếu thì không phục vụ.
SCHOOL_SSO_ISSUER=c3phucthinh.edu.vn
# BẮT BUỘC: vừa để tìm đúng dòng trong bảng schools, vừa để chặn phiếu ký cho
# email ngoài trường. Không có dòng schools khớp tên miền -> 503, không cấp phiên
# rồi thả giáo viên vào một ứng dụng trống.
SCHOOL_DOMAIN=c3phucthinh.edu.vn
# Trần vai trò mà phiếu được phép xin. Mặc định chỉ "teacher".
# Ghi vai trò vào profiles CHÍNH LÀ cấp quyền (auth_role() trong migration 005
# đọc đúng cột đó), nên "admin" ở đây nghĩa là ai ký được phiếu cũng tự cấp cho
# mình quyền xem camera lớp học. Nâng quyền là việc làm trong EduPortal, một
# lần, do người thật bấm.
SCHOOL_SSO_ALLOWED_ROLES=teacher
# Nhật ký ai vào bằng cửa này, ai bị từ chối, tài khoản nào vừa được tạo —
# Nghị định 13/2023 hỏi "ai đã truy cập?" cho cả dữ liệu học sinh, không riêng
# camera. Bỏ trống -> chỉ in ra stdout, mất khi tiến trình khởi động lại.
SCHOOL_SSO_ACCESS_LOG=./data/sso-access.log

# ⚠ Chỉ SSO cần khoá này. Tạo tài khoản là việc của quản trị viên, nên không
# có đường nào làm bằng anon key. Khoá này bỏ qua toàn bộ RLS — nếu bật SSO
# trên chính tiến trình đang chạy camera/AI thì một lỗ hổng ở đó là lộ cả CSDL.
# Cân nhắc chạy SSO ở tiến trình riêng. Dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
