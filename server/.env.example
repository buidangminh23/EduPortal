# Cổng máy chủ
PORT=8080

# ── Whisper (phiên âm giọng nói → văn bản) ──
# Dựng faster-whisper-server hoặc whisper.cpp server nội bộ rồi đặt URL vào đây.
# Bỏ trống -> endpoint vẫn chạy nhưng trả bản mô phỏng.
WHISPER_URL=

# ── LLM tóm tắt (Qwen2.5 chạy nội bộ qua Ollama/vLLM) ──
# Ví dụ Ollama: http://localhost:11434/api/chat
# Bỏ trống -> trả bản mô phỏng.
LLM_URL=
LLM_MODEL=qwen2.5:14b

# ── Fallback API (tuỳ chọn, chỉ khi không có model nội bộ) ──
GEMINI_API_KEY=

# ── STUN/TURN cho WebRTC (client dùng khi thiết lập RTCPeerConnection) ──
# STUN miễn phí của Google đủ cho mạng thường; TURN cần khi vượt NAT/tường lửa.
# Xem README mục "STUN/TURN".
# TURN_URL=turn:your-turn-server:3478
# TURN_USER=
# TURN_PASS=

# ── Camera giám sát (chỉ Ban Giám Hiệu) — xem CAMERA.md ──
# Danh sách camera; tệp này chứa mật khẩu camera nên KHÔNG commit.
CAMERA_CONFIG_FILE=./data/cameras.json
# Địa chỉ MediaMTX (WebRTC) trên máy đặt tại trường.
CAMERA_RELAY_URL=
# openssl rand -hex 32 — ký vé xem, thiếu cái này thì API từ chối mọi yêu cầu.
CAMERA_TICKET_SECRET=
CAMERA_TICKET_TTL_SECONDS=120
# openssl rand -hex 24 — khoá để lớp AI gửi ghi nhận về.
CAMERA_EVENT_KEY=
CAMERA_ACCESS_LOG=./data/camera-access.log
CAMERA_ALLOWED_ROLES=admin

# Server tự hỏi Supabase xem người gọi là ai; không dùng service key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
